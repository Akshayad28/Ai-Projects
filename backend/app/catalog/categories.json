  "attribute_library": {
    "ram_gb": {"label": "RAM", "value_type": "number", "unit": "GB", "filterable": true, "show_on_card": true, "higher_is_better": true,
      "patterns": ["(\\d{1,3})\\s?GB\\s*(?:LP)?(?:DDR\\d\\w*\\s*)?(?:RAM|Memory|Unified)", "RAM[:\\s]+(\\d{1,3})\\s?GB", "(\\d{1,2})\\s?GB\\s*\\+\\s*\\d{2,4}\\s?GB"],
