      "source_keys": ["material", "outer material", "frame material", "upholstery material", "fabric"]},
    "warranty_years": {"label": "Warranty", "value_type": "number", "unit": "yr", "filterable": true, "show_on_card": false, "higher_is_better": true,
      "patterns": ["(\\d{1,2})\\s?(?:-|\\s)?(?:year|yr)s?\\s*(?:manufacturer\\s*)?warranty"], "source_keys": ["warranty", "manufacturer warranty"]},
    "energy_rating": {"label": "Energy rating", "value_type": "number", "unit": "star", "filterable": true, "show_on_card": true, "higher_is_better": true,
      "patterns": ["(\\d)\\s?(?:-|\\s)?star"], "source_keys": ["energy rating", "energy star rating", "bee rating"]},
