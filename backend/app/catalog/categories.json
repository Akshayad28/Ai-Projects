{
  "$comment": "Category configuration seeded into categories / category_attributes / category_weights / category_rules. Add categories here (or directly in the DB) – no code changes required. Patterns are case-insensitive Python regexes; capture group 1 is the value.",
  "default_weights": {
    "relevance": 0.16,
    "requirement_match": 0.22,
    "price_fit": 0.14,
    "rating_quality": 0.14,
    "review_volume": 0.06,
    "availability": 0.08,
    "seller_quality": 0.06,
    "offer_coverage": 0.04,
    "warranty_returns": 0.04,
    "price_history": 0.06
