    "water_resistant": {"label": "Water resistance", "value_type": "bool", "filterable": true, "show_on_card": true,
      "patterns": ["\\b(Waterproof|Water[- ]Resistant|Water[- ]Repellent|Gore-?Tex|GTX|IPX\\d|IP6\\d|5ATM|10ATM)\\b"], "source_keys": ["water resistance", "water resistance level"]},
    "volume_ml": {"label": "Size", "value_type": "number", "unit": "ml", "filterable": true, "show_on_card": true,
      "patterns": ["(\\d{1,4})\\s?ml\\b", {"regex": "(\\d{1,4})\\s?g\\b", "multiply": 1}], "source_keys": ["volume", "net quantity", "item volume"]},
