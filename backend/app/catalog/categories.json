      "patterns": ["\\b(Men|Women|Unisex|Boys|Girls|Kids)(?:'s)?\\b"], "source_keys": ["gender", "department"]},
    "size": {"label": "Size", "value_type": "enum", "filterable": true, "show_on_card": false,
