    "storage_gb": {"label": "Storage", "value_type": "number", "unit": "GB", "filterable": true, "show_on_card": true, "higher_is_better": true,
      "patterns": ["(\\d{3,4})\\s?GB\\s*(?:PCIe\\s*)?(?:NVMe\\s*)?(?:SSD|Storage|ROM|eMMC|UFS)", {"regex": "(\\d)\\s?TB\\s*(?:PCIe\\s*)?(?:NVMe\\s*)?(?:SSD|Storage|HDD)?", "multiply": 1024}, "\\d{1,2}\\s?GB\\s*\\+\\s*(\\d{2,4})\\s?GB", "\\b(64|128|256|512)\\s?GB\\b"],
