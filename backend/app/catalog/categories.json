    "display_in": {"label": "Display", "value_type": "number", "unit": "in", "filterable": true, "show_on_card": true,
      "patterns": ["(\\d{1,2}(?:\\.\\d{1,2})?)\\s?(?:-|\\s)?(?:inch|inches|in\\b|\"|\u201d|\u2033)", "(\\d{2}(?:\\.\\d)?)\\s?cm\\s*\\((\\d{1,2}(?:\\.\\d)?)"],
      "source_keys": ["screen size", "display size", "screen size class"]},
    "battery_mah": {"label": "Battery", "value_type": "number", "unit": "mAh", "filterable": true, "show_on_card": true, "higher_is_better": true,
      "patterns": ["(\\d{4,5})\\s?mAh"], "source_keys": ["battery capacity", "battery"]},
    "battery_hours": {"label": "Battery life", "value_type": "number", "unit": "h", "filterable": true, "show_on_card": true, "higher_is_better": true,
      "patterns": ["(?:up to\\s*)?(\\d{1,3})\\s?(?:h|hrs?|hours)\\b(?:\\s*(?:battery|playback|playtime))?"], "source_keys": ["battery life", "maximum battery life"]},
    "weight_kg": {"label": "Weight", "value_type": "number", "unit": "kg", "filterable": false, "show_on_card": false, "higher_is_better": false,
      "patterns": ["(\\d{1,2}(?:\\.\\d{1,2})?)\\s?kg\\b", {"regex": "(\\d{3,4})\\s?g(?:rams?)?\\b", "multiply": 0.001}], "source_keys": ["weight", "item weight", "product weight"]},
    "color": {"label": "Colour", "value_type": "enum", "filterable": true, "show_on_card": false,
      "patterns": ["\\b(Black|White|Silver|Grey|Gray|Blue|Navy|Red|Green|Olive|Beige|Brown|Pink|Purple|Gold|Rose Gold|Graphite|Midnight|Titanium\\s?\\w*|Cream|Orange|Yellow|Charcoal|Teal|Walnut|Oak)\\b"],
      "source_keys": ["color", "colour", "color name"]},
    "material": {"label": "Material", "value_type": "enum", "filterable": true, "show_on_card": true,
