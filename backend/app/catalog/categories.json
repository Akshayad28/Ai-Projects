      "patterns": ["(\\d{1,4}(?:\\.\\d)?)\\s?(?:L|Ltr|Litres?|Liters?)\\b"], "source_keys": ["capacity", "volume capacity"]},
    "wattage_w": {"label": "Power", "value_type": "number", "unit": "W", "filterable": true, "show_on_card": true,
      "patterns": ["(\\d{2,4})\\s?(?:W|Watts?)\\b"], "source_keys": ["wattage", "power", "power consumption"]},
