# ============================================================
# SHOPBUDDY AI — ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env and configure the credentials for your environment.
# NEVER commit .env to version control.

ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# Demo mode: When false (default), NO mock or demo product data will appear.
# Only verified data from configured providers is returned.
# Refused automatically when ENVIRONMENT=production.
DEMO_MODE=false

# Allowed frontend origins for CORS (comma-separated or JSON list)
CORS_ORIGINS=https://shopbuddy.vercel.app,http://localhost:3000

# ── Database & Cache ──
# Supabase / PostgreSQL connection string:
# DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:5432/postgres?ssl=require
# Local development default:
DATABASE_URL=sqlite+aiosqlite:///./shopbuddy-dev.db

# Redis connection URL for caching and Celery workers:
# REDIS_URL=redis://localhost:6379/0

# ── Authentication ──
JWT_SECRET=super-secret-shopbuddy-key-replace-in-production

# ── AI / Intent Parsing Providers ──
# LLM is used ONLY for natural language intent extraction and review summarization.
# LLM NEVER invents product facts, models, or prices.
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
ANTHROPIC_API_KEY=

# ── Real Product Providers ──
# 1. SerpApi (Google Shopping API):
# https://serpapi.com/google-shopping-api
SEARCH_PROVIDER_API_KEY=

# 2. Best Buy Products API:
# https://developer.bestbuy.com
BESTBUY_API_KEY=

# 3. eBay Browse API (OAuth 2.0 Client Credentials):
# https://developer.ebay.com/api-docs/buy/browse/overview.html
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_AFFILIATE_CAMPAIGN_ID=

# 4. Amazon Product Advertising API 5.0 (PA-API):
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=

# 5. Flipkart Affiliate API:
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# 6. Merchant Feeds (Google Merchant Center CSV/TSV/XML feed URLs):
MERCHANT_FEED_URLS=[]
GOOGLE_MERCHANT_ACCOUNT_ID=

# ── Google Shopping Scraper (Playwright, no API key required) ──
GOOGLE_SCRAPER_ENABLED=true
GOOGLE_SCRAPER_COUNTRY=IN
GOOGLE_SCRAPER_LANGUAGE=en
GOOGLE_SCRAPER_CURRENCY=INR
GOOGLE_SCRAPER_TIMEOUT_SECONDS=20
GOOGLE_SCRAPER_MAX_RESULTS=20
GOOGLE_SCRAPER_CACHE_TTL_SECONDS=300
GOOGLE_REQUESTS_PER_SECOND=1.0
GOOGLE_MAX_RETRIES=1
GOOGLE_CIRCUIT_BREAKER_COOLDOWN_SECONDS=900
GOOGLE_EXTRACTION_HEALTH_THRESHOLD=0.2

# Optional licensed SerpApi toggle (works alongside or independently of scraper)
SERPAPI_ENABLED=true

# ── Firecrawl Provider (Universal Web Discovery & Product Extraction) ──
# Official Firecrawl API key (obtain from https://firecrawl.dev)
FIRECRAWL_API_KEY=
FIRECRAWL_ENABLED=true
FIRECRAWL_SEARCH_ENABLED=true
FIRECRAWL_SCRAPE_ENABLED=true
FIRECRAWL_EXTRACTION_ENABLED=true
FIRECRAWL_MAX_SEARCH_RESULTS=20
FIRECRAWL_MAX_SCRAPE_PAGES=10
FIRECRAWL_REQUEST_TIMEOUT_SECONDS=30
FIRECRAWL_CONCURRENCY=5
FIRECRAWL_CACHE_TTL_SECONDS=900

# ── Quick Commerce Provider (Instant Delivery & Grocery Platforms) ──
ENABLE_QUICK_COMMERCE=true
